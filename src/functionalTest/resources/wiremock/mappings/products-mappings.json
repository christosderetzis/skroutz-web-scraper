  "mappings": [
    {
      "request": {
        "method": "GET",
        "urlPathPattern": ".*/products-page\\.json"
      },
      "response": {
        "status": 200,
        "bodyFileName": "products-page.json",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
