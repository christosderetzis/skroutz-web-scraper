{
  "analysis": {
    "analyzer": {
      "greek_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "greek_stop",
          "greek_stemmer"
        ]
      },
      "english_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "english_stop",
          "english_stemmer"
        ]
      },
      "autocomplete": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "autocomplete_filter"]
      }
    },
    "filter": {
      "greek_stop": {
        "type": "stop",
        "stopwords": "_greek_"
      },
      "english_stop": {
        "type": "stop",
        "stopwords": "_english_"
      },
      "greek_stemmer": {
        "type": "stemmer",
        "language": "greek"
      },
      "english_stemmer": {
        "type": "stemmer",
        "language": "english"
      },
      "autocomplete_filter": {
         "type": "edge_ngram",
         "min_gram": 2,
         "max_gram": 20
        }
    }
  }
}
